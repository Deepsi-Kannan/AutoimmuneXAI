{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "fluid": true,
  "installCommand": "npm ci --prefix AutoimmuneXAI/frontend",
  "buildCommand": "VITE_API_BASE_URL=/api npm run build --prefix AutoimmuneXAI/frontend",
  "outputDirectory": "AutoimmuneXAI/frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "{AutoimmuneXAI/backend/*.py,AutoimmuneXAI/models/autoimmune_xgb_model.joblib}",
      "excludeFiles": "{.deployment-checks/**,scripts/**,AutoimmuneXAI/{frontend,deployment,scripts,tests,.deployment-checks}/**,**/{__pycache__,node_modules,.venv,venv}/**,**/.env*,**/Dockerfile,**/.dockerignore,render.yaml,AutoimmuneXAI/*.{csv,xlsx}}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    }
  ]
}
